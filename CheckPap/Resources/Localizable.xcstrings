      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print this letter, sign it and send it by registered mail with acknowledgement of receipt. Keep a copy and the receipt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبع هذه الرسالة ووقّعها، ثم أرسلها بالبريد المضمون مع إشعار بالاستلام (⁦lettre recommandée avec avis de réception⁩). احتفظ بنسخة وبالإيصال."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نامه را چاپ و امضا کنید و آن را با پست سفارشی همراه با رسید دریافت (⁦lettre recommandée avec avis de réception⁩) بفرستید. یک کاپی و رسید را نگه دارید."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا لیک چاپ کړئ، لاسلیک یې کړئ او د ترلاسه کولو له خبرتیا سره په ثبت شوي پوسټ (⁦lettre recommandée avec avis de réception⁩) یې ولېږئ. یوه کاپي او رسید وساتئ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ خط پرنٹ کریں، اس پر دستخط کریں اور اسے رسید وصولی کے ساتھ رجسٹرڈ ڈاک (⁦lettre recommandée avec avis de réception⁩) سے بھیجیں۔ ایک کاپی اور رسید سنبھال کر رکھیں۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ነዚ ደብዳቤ ሕተምዎ፡ ፈርምዎ፡ ብምዝጉብ ፖስታ ምስ መረጋገጺ ምቕባል (lettre recommandée avec avis de réception) ስደድዎ። ቅዳሕን ቅብሊትን ዓቅቡ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetak surat ini, tanda tangani, lalu kirim dengan surat tercatat dengan bukti terima (lettre recommandée avec avis de réception). Simpan salinannya dan tanda terimanya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打印这封信，签名，然后用挂号信并附回执 (lettre recommandée avec avis de réception) 寄出。请保留一份副本和收据。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पत्र प्रिंट करें, इस पर हस्ताक्षर करें, और इसे पावती के साथ रजिस्टर्ड डाक (lettre recommandée avec avis de réception) से भेजें। एक कॉपी और रसीद संभाल कर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই চিঠিটি প্রিন্ট করুন, সই করুন, এবং প্রাপ্তিস্বীকারসহ রেজিস্টার্ড ডাকে (lettre recommandée avec avis de réception) পাঠান। একটি কপি ও রসিদ রেখে দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கடிதத்தை அச்சிட்டு, கையெழுத்திட்டு, ஒப்புகைச் சீட்டுடன் கூடிய பதிவுத் தபாலில் (lettre recommandée avec avis de réception) அனுப்புங்கள். ஒரு நகலையும் ரசீதையும் வைத்துக்கொள்ளுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์จดหมายนี้ ลงชื่อ แล้วส่งทางไปรษณีย์ลงทะเบียนตอบรับ (lettre recommandée avec avis de réception) เก็บสำเนาและใบรับไว้"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распечатайте это письмо, подпишите его и отправьте заказным письмом с уведомлением о вручении (lettre recommandée avec avis de réception). Сохраните копию и квитанцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Роздрукуйте цей лист, підпишіть його та надішліть рекомендованим листом із повідомленням про вручення (lettre recommandée avec avis de réception). Збережіть копію та квитанцію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mektubu yazdırın, imzalayın ve alındı belgeli taahhütlü mektup (lettre recommandée avec avis de réception) olarak gönderin. Bir kopyasını ve makbuzu saklayın."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima esta carta, assine e envie como carta registrada com aviso de recebimento (lettre recommandée avec avis de réception). Guarde uma cópia e o comprovante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima esta carta, fírmela y envíela por correo certificado con acuse de recibo (lettre recommandée avec avis de réception). Guarde una copia y el comprobante."
          }
        }
      }
    },
