    "Supprimer ce dossier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this application"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف هذا الملف"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف این پرونده"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا دوسیه ړنګه کړئ"
          }
        },
