    "Ex. : numéro de rendez-vous, guichet, pièces à ne pas oublier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E.g. appointment number, counter, documents not to forget"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: رقم الموعد، الشباك، الوثائق التي يجب ألا تنساها"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: شماره وقت ملاقات، باجه، مدارکی که نباید فراموش شوند"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "بېلګه: د ملاقات شمېره، کړکۍ، هغه اسناد چې باید هېر نه شي"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: اپائنٹمنٹ نمبر، کاؤنٹر، وہ دستاویزات جو بھولنی نہیں"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ኣብነት፡ ቁጽሪ ቆጸራ፡ መሳኹቲ፡ ክትርስዕዎም ዘይብልኩም ሰነዳት"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: nomor janji temu, loket, dokumen yang tidak boleh lupa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：预约编号、窗口、不要忘记的材料"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदा.: अपॉइंटमेंट नंबर, काउंटर, न भूलने वाले दस्तावेज़"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেমন: অ্যাপয়েন্টমেন্ট নম্বর, কাউন্টার, যে কাগজপত্র ভুলবেন না"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எ.கா.: சந்திப்பு எண், கவுண்டர், மறக்கக் கூடாத ஆவணங்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น หมายเลขนัดหมาย ช่องบริการ เอกสารที่ห้ามลืม"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: номер записи, окно, документы, которые нельзя забыть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: номер запису, віконце, документи, які не можна забути"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn.: randevu numarası, gişe, unutulmaması gereken belgeler"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: número do agendamento, guichê, documentos para não esquecer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej.: número de cita, ventanilla, documentos que no debe olvidar"
          }
        }
      }
    },
