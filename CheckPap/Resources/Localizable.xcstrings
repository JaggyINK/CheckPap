    "Effacer vos réponses et vos coches pour cette démarche ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your answers and ticks for this procedure?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح إجاباتك وعلاماتك لهذا الإجراء؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها و علامت‌های خود را برای این کار اداری پاک می‌کنید؟"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "ایا غواړئ د دې اداري کار لپاره خپل ځوابونه او نښې پاکې کړئ؟"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا اس کارروائی کے لیے آپ کے جوابات اور نشانات مٹا دیے جائیں؟"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ነዚ መስርሕ ዝምልከት መልስታትኩምን ምልክታትኩምን ክድምሰሱ ትደልዩ ዲኹም?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus jawaban dan centang Anda untuk urusan ini?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除此手续的回答和勾选吗？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रक्रिया के लिए आपके उत्तर और टिक हटा दें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রক্রিয়ার জন্য আপনার উত্তর ও টিক চিহ্ন মুছে ফেলবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நடைமுறைக்கான உங்கள் பதில்களையும் குறிகளையும் அழிக்கவா?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคำตอบและเครื่องหมายที่คุณทำไว้สำหรับเรื่องนี้ใช่ไหม"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить ваши ответы и отметки для этой процедуры?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити ваші відповіді та позначки для цієї процедури?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem için yanıtlarınız ve işaretleriniz silinsin mi?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar suas respostas e marcações para este procedimento?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar sus respuestas y marcas de este trámite?"
          }
        }
      }
    },
