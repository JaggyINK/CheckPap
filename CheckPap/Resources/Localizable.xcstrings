    "Touchez le numéro d'une étape quand elle est faite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a step's number when it is done."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس رقم الخطوة عند إنجازها."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی مرحله‌ای انجام شد، روی شماره آن بزنید."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "کله چې یو پړاو ترسره شو، د هغه پر شمېره ټک وکړئ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی مرحلہ مکمل ہو جائے تو اس کے نمبر کو ٹچ کریں۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ስጉምቲ ምስ ተገብረ፡ ቁጽሩ ጠውቑ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk nomor langkah setelah langkah itu selesai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成某个步骤后，请点击该步骤的编号。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई चरण पूरा हो जाए, तो उसके नंबर पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ধাপ শেষ হলে তার নম্বরে ট্যাপ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு படி முடிந்ததும் அதன் எண்ணைத் தொடுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะหมายเลขของขั้นตอนเมื่อทำเสร็จแล้ว"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на номер этапа, когда он выполнен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть на номер етапу, коли його виконано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir adım tamamlandığında numarasına dokunun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no número de uma etapa quando ela estiver feita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el número de un paso cuando esté hecho."
          }
        }
      }
    },
    "Touchez une pièce pour voir le détail, et le rond pour la cocher quand elle est prête.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a document to see the details, and the circle to tick it when it is ready."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الوثيقة لرؤية التفاصيل، والدائرة لوضع علامة عليها عندما تكون جاهزة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی یک مدرک بزنید تا جزئیات را ببینید، و وقتی آماده شد روی دایره بزنید تا علامت بخورد."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "پر یوه سند ټک وکړئ ترڅو جزئیات وګورئ، او کله چې چمتو شو پر کړۍ ټک وکړئ ترڅو نښه شي."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تفصیل دیکھنے کے لیے کسی دستاویز کو ٹچ کریں، اور تیار ہونے پر نشان لگانے کے لیے دائرے کو ٹچ کریں۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ዝርዝር ንምርኣይ ሰነድ ጠውቑ፡ ምስ ተዳለወ ድማ ምልክት ንምግባር ነቲ ክቢ ጠውቑ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dokumen untuk melihat rinciannya, dan ketuk lingkaran untuk mencentangnya saat sudah siap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击某份材料可查看详情，准备好后点击圆圈勾选。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण देखने के लिए किसी दस्तावेज़ पर टैप करें, और तैयार होने पर टिक करने के लिए गोले पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিস্তারিত দেখতে কোনো কাগজে ট্যাপ করুন, আর প্রস্তুত হলে টিক দিতে বৃত্তে ট্যাপ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விவரங்களைப் பார்க்க ஓர் ஆவணத்தைத் தொடுங்கள், தயாரானதும் குறியிட வட்டத்தைத் தொடுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเอกสารเพื่อดูรายละเอียด และแตะวงกลมเพื่อทำเครื่องหมายเมื่อเอกสารพร้อม"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на документ, чтобы увидеть подробности, и на кружок, чтобы отметить его, когда он готов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть на документ, щоб побачити подробиці, і на кружечок, щоб позначити його, коли він готовий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntıları görmek için bir belgeye, hazır olduğunda işaretlemek için yuvarlağa dokunun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um documento para ver os detalhes, e no círculo para marcá-lo quando estiver pronto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque un documento para ver los detalles, y el círculo para marcarlo cuando esté listo."
          }
        }
      }
    },
