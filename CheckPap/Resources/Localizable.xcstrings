    "Indiquez votre code postal pour trouver votre préfecture et sa page de rendez-vous.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your postcode to find your prefecture and its appointment page."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمزك البريدي للعثور على محافظتك (⁦préfecture⁩) وصفحة المواعيد الخاصة بها."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد پستی خود را وارد کنید تا اداره ولایت (⁦préfecture⁩) و صفحه وقت ملاقات آن را پیدا کنید."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "خپل پوستي کوډ ولیکئ ترڅو خپله د ولایت اداره (⁦préfecture⁩) او د هغې د ملاقات پاڼه ومومئ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پوسٹل کوڈ درج کریں تاکہ آپ کا ضلعی دفتر (⁦préfecture⁩) اور اس کا اپائنٹمنٹ صفحہ مل سکے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ምምሕዳር ኣውራጃኹም (préfecture) ን ገጽ ቆጸራኡን ንምርካብ ፖስታዊ ኮድኩም ኣእትዉ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode pos Anda untuk menemukan kantor prefektur (préfecture) Anda dan halaman janji temunya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入您的邮政编码，查找您所在的省政府 (préfecture) 及其预约页面。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना प्रीफ़ेक्चर (préfecture) और उसका अपॉइंटमेंट पेज ढूँढने के लिए अपना पिन कोड डालें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রিফেকচার (préfecture) ও তার অ্যাপয়েন্টমেন্ট পেজ খুঁজতে আপনার পোস্ট কোড লিখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பிரிஃபெக்சரையும் (préfecture) அதன் சந்திப்புப் பக்கத்தையும் கண்டறிய உங்கள் அஞ்சல் குறியீட்டை உள்ளிடுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกรหัสไปรษณีย์ของคุณเพื่อค้นหาศาลากลางจังหวัด (préfecture) และหน้านัดหมายของที่นั่น"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите почтовый индекс, чтобы найти вашу префектуру (préfecture) и ее страницу записи на прием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть поштовий індекс, щоб знайти вашу префектуру (préfecture) та її сторінку запису на прийом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valiliğinizi (préfecture) ve randevu sayfasını bulmak için posta kodunuzu girin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o seu código postal para encontrar a sua prefeitura (préfecture) e a página de agendamento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique su código postal para encontrar su prefectura (préfecture) y su página de citas."
          }
        }
      }
    },
    "Indiqué sur votre attestation de dépôt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on your proof of submission"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مذكور في شهادة الإيداع (⁦attestation de dépôt⁩)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در گواهی تسلیم پرونده (⁦attestation de dépôt⁩) شما نوشته شده است"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "ستاسو د سپارلو په تصدیق‌لیک (⁦attestation de dépôt⁩) کې لیکل شوی"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جمع کرانے کی تصدیق (⁦attestation de dépôt⁩) پر درج ہے"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ኣብ ናይ ምቕራብ ምስክር ወረቐትኩም (attestation de dépôt) ተጻሒፉ ኣሎ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tertulis pada bukti pengajuan Anda (attestation de dépôt)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写在您的递交证明 (attestation de dépôt) 上"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जमा प्रमाणपत्र (attestation de dépôt) पर लिखा है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জমার প্রত্যয়নপত্রে (attestation de dépôt) লেখা আছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சமர்ப்பிப்புச் சான்றிதழில் (attestation de dépôt) குறிப்பிடப்பட்டுள்ளது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุอยู่ในหนังสือรับรองการยื่นเรื่อง (attestation de dépôt) ของคุณ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указан в вашей справке о подаче (attestation de dépôt)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вказано у вашій довідці про подання (attestation de dépôt)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başvuru belgenizde (attestation de dépôt) yazılıdır"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicado no seu comprovante de entrega (attestation de dépôt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicado en su constancia de entrega (attestation de dépôt)"
          }
        }
      }
    },
