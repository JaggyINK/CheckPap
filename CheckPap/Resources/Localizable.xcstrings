    "Un programme vacances-travail existe avec ce pays (%lld à %lld ans) : votre âge est dans la tranche.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Un programme vacances-travail existe avec ce pays (%1$lld à %2$lld ans) : votre âge est dans la tranche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A working holiday programme exists with this country (ages %lld to %lld): your age is within the range."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد برنامج عطلة وعمل مع هذا البلد (⁦من %lld إلى %lld سنة⁩): عمرك ضمن الفئة المطلوبة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کشور برنامه سفر و کار (⁦vacances-travail⁩) وجود دارد (⁦از %lld تا %lld سال⁩): سن شما در این محدوده است."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "له دې هېواد سره د رخصتۍ او کار پروګرام (⁦vacances-travail⁩) شته (⁦له %lld تر %lld کلنۍ⁩): ستاسو عمر په دې حد کې دی."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ملک کے ساتھ چھٹی اور کام کا پروگرام (⁦vacances-travail⁩) موجود ہے (⁦%lld سے %lld سال⁩): آپ کی عمر اس حد میں ہے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ምስዚ ሃገር ናይ ዕረፍትን ስራሕን መደብ (vacances-travail) ኣሎ (ካብ %lld ክሳብ %lld ዓመት)፡ ዕድሜኹም ኣብዚ ደረት እዚ እዩ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada program liburan-kerja dengan negara ini (%lld sampai %lld tahun): usia Anda termasuk dalam rentang ini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该国有打工度假计划（%lld 至 %lld 岁）：您的年龄在此范围内。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस देश के साथ एक वर्किंग हॉलिडे कार्यक्रम है (%lld से %lld साल): आपकी उम्र इस सीमा में है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দেশের সঙ্গে একটি ওয়ার্কিং হলিডে প্রোগ্রাম আছে (%lld থেকে %lld বছর): আপনার বয়স এই সীমার মধ্যে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நாட்டுடன் ஒரு விடுமுறை-வேலைத் திட்டம் உள்ளது (%lld முதல் %lld வயது வரை): உங்கள் வயது இந்த வரம்புக்குள் உள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีโครงการวันหยุดและทำงานกับประเทศนี้ (อายุ %lld ถึง %lld ปี): อายุของคุณอยู่ในช่วงนี้"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этой страной есть программа «отпуск и работа» (от %lld до %lld лет): ваш возраст подходит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З цією країною є програма «відпустка та робота» (від %lld до %lld років): ваш вік підходить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ülkeyle bir çalışma tatili programı var (%lld-%lld yaş): yaşınız bu aralıkta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um programa de férias-trabalho com este país (de %lld a %lld anos): a sua idade está dentro da faixa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe un programa de vacaciones y trabajo con este país (de %lld a %lld años): su edad está dentro del rango."
          }
        }
      }
    },
    "Un programme vacances-travail existe avec ce pays, réservé aux %lld à %lld ans.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Un programme vacances-travail existe avec ce pays, réservé aux %1$lld à %2$lld ans."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A working holiday programme exists with this country, for people aged %lld to %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد برنامج عطلة وعمل مع هذا البلد، مخصص للأشخاص من %lld إلى %lld سنة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کشور برنامه سفر و کار (⁦vacances-travail⁩) وجود دارد، مخصوص افراد %lld تا %lld ساله."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "له دې هېواد سره د رخصتۍ او کار پروګرام (⁦vacances-travail⁩) شته، یوازې له %lld تر %lld کلنو کسانو لپاره."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ملک کے ساتھ چھٹی اور کام کا پروگرام (⁦vacances-travail⁩) موجود ہے، جو %lld سے %lld سال کے افراد کے لیے ہے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ምስዚ ሃገር ናይ ዕረፍትን ስራሕን መደብ (vacances-travail) ኣሎ፡ ንካብ %lld ክሳብ %lld ዓመት ዕድሜ ዘለዎም ጥራይ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada program liburan-kerja dengan negara ini, khusus untuk usia %lld sampai %lld tahun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该国有打工度假计划，仅限 %lld 至 %lld 岁。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस देश के साथ एक वर्किंग हॉलिडे कार्यक्रम है, केवल %lld से %lld साल के लोगों के लिए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দেশের সঙ্গে একটি ওয়ার্কিং হলিডে প্রোগ্রাম আছে, শুধু %lld থেকে %lld বছর বয়সীদের জন্য।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நாட்டுடன் ஒரு விடுமுறை-வேலைத் திட்டம் உள்ளது, %lld முதல் %lld வயது வரை உள்ளவர்களுக்கு மட்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีโครงการวันหยุดและทำงานกับประเทศนี้ สำหรับผู้มีอายุ %lld ถึง %lld ปีเท่านั้น"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этой страной есть программа «отпуск и работа» для людей от %lld до %lld лет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З цією країною є програма «відпустка та робота» для людей від %lld до %lld років."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ülkeyle %lld-%lld yaş arasındakilere özel bir çalışma tatili programı var."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um programa de férias-trabalho com este país, reservado a pessoas de %lld a %lld anos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe un programa de vacaciones y trabajo con este país, reservado a personas de %lld a %lld años."
          }
        }
      }
    },
