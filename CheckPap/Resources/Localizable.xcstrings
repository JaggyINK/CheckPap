          "stringUnit": {
            "state": "translated",
            "value": "ናጻ ኣገልግሎት። መንግስታዊ መስርሓት ብናጻ እዮም።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan independen. Prosedur pemerintah tidak dipungut biaya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立服务。政府手续均为免费。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतंत्र सेवा। सरकारी प्रक्रियाएँ मुफ़्त हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাধীন সেবা। সরকারি প্রক্রিয়াগুলো বিনামূল্যে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுயாதீன சேவை. அரசு நடைமுறைகள் இலவசம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการอิสระ ขั้นตอนของรัฐไม่มีค่าใช้จ่าย"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Независимый сервис. Государственные процедуры бесплатны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незалежний сервіс. Державні процедури безкоштовні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız bir hizmettir. Resmî işlemler ücretsizdir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço independente. Os procedimentos oficiais são gratuitos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio independiente. Los trámites oficiales son gratuitos."
          }
        }
      }
    },
    "Seulement les documents qui vous concernent, avec des exemples.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the documents that apply to you, with examples."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط الوثائق التي تعنيك، مع أمثلة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط مدارکی که به شما مربوط است، همراه با مثال."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "یوازې هغه اسناد چې تاسو پورې اړه لري، د بېلګو سره."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف وہ دستاویزات جو آپ سے متعلق ہیں، مثالوں کے ساتھ۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ንዓኹም ዝምልከቱ ሰነዳት ጥራይ፡ ምስ ኣብነታት።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dokumen yang berkaitan dengan Anda, dengan contoh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只列出与您有关的材料，并附有示例。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ वही दस्तावेज़ जो आपसे जुड़े हैं, उदाहरणों के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার সঙ্গে সম্পর্কিত কাগজপত্র, উদাহরণসহ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தொடர்புடைய ஆவணங்கள் மட்டும், எடுத்துக்காட்டுகளுடன்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเอกสารที่เกี่ยวข้องกับคุณ พร้อมตัวอย่าง"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только те документы, которые касаются вас, с примерами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ті документи, які стосуються вас, із прикладами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sizi ilgilendiren belgeler, örneklerle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os documentos que se aplicam a você, com exemplos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los documentos que le corresponden, con ejemplos."
          }
        }
      }
    },
