    "Oui, j'enregistre mon rendez-vous": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, I'll save my appointment"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نعم، أريد حفظ موعدي"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بله، وقت ملاقاتم را ذخیره می‌کنم"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "هو، خپل د ملاقات وخت خوندي کوم"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جی ہاں، میں اپنی اپائنٹمنٹ محفوظ کرتا/کرتی ہوں"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "እወ፡ ቆጸራይ ክዕቅብ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, saya simpan janji temu saya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，保存我的预约"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ, मैं अपना अपॉइंटमेंट सेव करता/करती हूँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ, আমার অ্যাপয়েন্টমেন্ট সংরক্ষণ করছি"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆம், என் சந்திப்பைச் சேமிக்கிறேன்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช่ บันทึกนัดหมายของฉัน"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, сохранить мою запись"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
