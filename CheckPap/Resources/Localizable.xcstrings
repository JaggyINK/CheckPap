    "Informations vérifiées le %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information checked on %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من المعلومات في %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات در تاریخ %@ بررسی شده است"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات په %@ وکتل شول"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات %@ کو جانچی گئیں"
