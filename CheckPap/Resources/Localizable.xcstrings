    "Service indépendant. Les démarches officielles sont gratuites.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent service. Government procedures are free of charge."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة مستقلة. الإجراءات الحكومية مجانية."
          }
        },
        "fa": {
