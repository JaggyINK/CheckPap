    "Où déposer, quand, et ce qui se passe ensuite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to submit, when, and what happens next."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين تقدّم الملف، ومتى، وماذا يحدث بعد ذلك."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کجا و چه وقت تسلیم کنید و بعد از آن چه اتفاقی می‌افتد."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "چېرته او کله یې وسپارئ، او وروسته څه کېږي."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کہاں اور کب جمع کرائیں، اور اس کے بعد کیا ہوتا ہے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ኣበይን መዓስን ከም እተቕርቡ፡ ድሕሪኡ እንታይ ከም ዝኸውን።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana mengajukan, kapan, dan apa yang terjadi selanjutnya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在哪里递交、何时递交，以及之后会怎样。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहाँ जमा करें, कब, और उसके बाद क्या होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোথায় জমা দেবেন, কখন, এবং তারপর কী হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்கே சமர்ப்பிப்பது, எப்போது, அதன் பிறகு என்ன நடக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยื่นที่ไหน เมื่อไร และจะเกิดอะไรขึ้นต่อไป"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда подавать, когда и что будет дальше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Куди подавати, коли і що буде далі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nereye, ne zaman başvurulur ve sonra ne olur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde entregar, quando e o que acontece depois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde entregar, cuándo y qué pasa después."
          }
        }
      }
    },
