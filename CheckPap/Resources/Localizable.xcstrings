    "Lois, taxes, délais et aides : les dernières nouvelles publiées par l'administration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laws, taxes, deadlines and benefits: the latest news published by the administration."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوانين والرسوم والمواعيد النهائية والمساعدات: آخر الأخبار التي نشرتها الإدارة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قوانین، مالیات، مهلت‌ها و کمک‌ها: تازه‌ترین خبرهایی که اداره‌های دولتی منتشر کرده‌اند."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "قوانین، مالیات، مهلتونه او مرستې: هغه وروستي خبرونه چې دولتي ادارې خپاره کړي دي."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قوانین، ٹیکس، آخری تاریخیں اور امداد: انتظامیہ کی جاری کردہ تازہ ترین خبریں۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ሕግታት፡ ቀረጻት፡ ግዜ ገደባትን ሓገዛትን፡ እቶም ምምሕዳር ዝዘርግሖም ሓደሽቲ ዜናታት።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undang-undang, pajak, tenggat waktu, dan bantuan: berita terbaru dari pemerintah Prancis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法律、税费、期限和补助：政府部门发布的最新消息。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क़ानून, कर, समय-सीमा और सहायता: सरकारी विभागों द्वारा प्रकाशित ताज़ा ख़बरें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইন, কর, সময়সীমা ও সহায়তা: সরকারি দপ্তরের প্রকাশিত সর্বশেষ খবর।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சட்டங்கள், வரிகள், காலக்கெடுக்கள், உதவிகள்: அரசுத் துறைகள் வெளியிட்ட சமீபத்திய செய்திகள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎหมาย ภาษี กำหนดเวลา และความช่วยเหลือ: ข่าวล่าสุดที่หน่วยงานรัฐเผยแพร่"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Законы, сборы, сроки и пособия: последние новости, опубликованные государственными органами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закони, збори, терміни та допомога: останні новини, опубліковані державними органами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yasalar, harçlar, süreler ve yardımlar: kamu kurumlarının yayımladığı son haberler."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leis, taxas, prazos e auxílios: as últimas notícias publicadas pela administração pública."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyes, tasas, plazos y ayudas: las últimas noticias publicadas por la administración pública."
          }
        }
      }
    },
    "Marquer comme prête": {
      "localizations": {
