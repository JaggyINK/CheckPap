    "Demandée à toutes les personnes qui font cette démarche.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required from everyone doing this procedure."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوبة من جميع الأشخاص الذين يقومون بهذا الإجراء."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از همه کسانی که این کار اداری را انجام می‌دهند خواسته می‌شود."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "له ټولو هغو کسانو غوښتل کېږي چې دا اداري کار کوي."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کارروائی کرنے والے ہر شخص سے مانگی جاتی ہے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ካብ ኩሎም እዚ መስርሕ ዝገብሩ ሰባት ይሕተት።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminta dari semua orang yang mengurus hal ini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有办理此手续的人都需要提供。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रक्रिया करने वाले सभी लोगों से माँगा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রক্রিয়া করা সবার কাছেই চাওয়া হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நடைமுறையைச் செய்யும் அனைவரிடமும் கேட்கப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนที่ดำเนินเรื่องนี้ต้องใช้"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется от всех, кто проходит эту процедуру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагається від усіх, хто проходить цю процедуру."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemi yapan herkesten istenir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido a todas as pessoas que fazem este procedimento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide a todas las personas que hacen este trámite."
          }
        }
      }
    },
