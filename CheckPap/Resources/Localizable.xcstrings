{
  "sourceLanguage": "fr",
  "strings": {
    "%lld droits et aides peuvent vous concerner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld rights and benefits may apply to you"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تعنيك %lld من الحقوق والمساعدات"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld حق و کمک ممکن است شامل حال شما شود"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld حقونه او مرستې کېدای شي ستاسو لپاره وي"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld حقوق اور امداد آپ کے لیے ہو سکتے ہیں"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld መሰላትን ሓገዛትን ንዓኹም ክምልከቱ ይኽእሉ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hak dan bantuan mungkin berlaku untuk Anda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 项权利和补助可能与您有关"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld अधिकार और सहायताएँ आप पर लागू हो सकती हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি অধিকার ও সহায়তা আপনার ক্ষেত্রে প্রযোজ্য হতে পারে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உரிமைகளும் உதவிகளும் உங்களுக்குப் பொருந்தலாம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิและความช่วยเหลือ %lld รายการที่อาจเกี่ยวข้องกับคุณ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас могут касаться права и пособия: %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас можуть стосуватися права та допомоги: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi ilgilendirebilecek %lld hak ve yardım var"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld direitos e auxílios podem se aplicar ao seu caso"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld derechos y ayudas pueden aplicarse a su caso"
          }
        }
      }
    },
    "%lld fiches pays : visas, santé, protection sociale, contacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld country guides: visas, health, social security, contacts"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld بطاقة عن البلدان: التأشيرات، الصحة، الحماية الاجتماعية، جهات الاتصال"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld معرفی‌نامه کشور: ویزا، صحت، تأمین اجتماعی، شماره‌های تماس"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld د هېوادونو پاڼې: ویزې، روغتیا، ټولنیز خوندیتوب، اړیکې"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ممالک کی معلومات: ویزا، صحت، سماجی تحفظ، رابطے"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ሓበሬታ ሃገራት፡ ቪዛ፡ ጥዕና፡ ማሕበራዊ ውሕስነት፡ መራኸቢታት"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lembar info negara: visa, kesehatan, jaminan sosial, kontak"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 份国家资料：签证、医疗、社会保障、联系方式"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld देशों की जानकारी: वीज़ा, स्वास्थ्य, सामाजिक सुरक्षा, संपर्क"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি দেশের তথ্য: ভিসা, স্বাস্থ্য, সামাজিক সুরক্ষা, যোগাযোগ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld நாட்டுத் தகவல் தாள்கள்: விசா, உடல்நலம், சமூகப் பாதுகாப்பு, தொடர்புகள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลประเทศ %lld ประเทศ: วีซ่า สุขภาพ สวัสดิการสังคม ช่องทางติดต่อ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страновые справки (%lld): визы, здоровье, социальная защита, контакты"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довідки про країни (%lld): візи, здоров'я, соціальний захист, контакти"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ülke bilgi sayfası: vize, sağlık, sosyal güvenlik, iletişim"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichas de países: vistos, saúde, proteção social, contatos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichas de países: visas, salud, protección social, contactos"
          }
        }
      }
    },
    "%lld questions au maximum, une par écran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld questions at most, one per screen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld أسئلة على الأكثر، سؤال واحد في كل شاشة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر %lld سؤال، در هر صفحه یک سؤال."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "تر ټولو زیات %lld پوښتنې، په هره پاڼه کې یوه."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ %lld سوالات، ہر اسکرین پر ایک۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ቢዝበዝሐ %lld ሕቶታት፡ ኣብ ነፍሲ ወከፍ ገጽ ሓደ ሕቶ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak %lld pertanyaan, satu per layar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 个问题，每屏一个。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा से ज़्यादा %lld प्रश्न, हर स्क्रीन पर एक।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ %lldটি প্রশ্ন, প্রতি স্ক্রিনে একটি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்சம் %lld கேள்விகள், ஒரு திரைக்கு ஒன்று."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกิน %lld คำถาม หน้าจอละหนึ่งคำถาม"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более %lld вопросов, по одному на экране."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше %lld запитань, по одному на екрані."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla %lld soru, her ekranda bir soru."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo %lld perguntas, uma por tela."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo %lld preguntas, una por pantalla."
          }
        }
      }
    },
