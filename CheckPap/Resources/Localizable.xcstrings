    "Gardées uniquement sur ce téléphone, pour vos prochains courriers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only on this phone, for your next letters."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ فقط على هذا الهاتف، لرسائلك القادمة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط در همین تلفن نگهداری می‌شوند، برای نامه‌های بعدی شما."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "یوازې په همدې تلیفون کې ساتل کېږي، ستاسو د راتلونکو لیکونو لپاره."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اسی فون پر محفوظ رہتی ہیں، آپ کے اگلے خطوط کے لیے۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ንዝመጽእ ደብዳቤታትኩም፡ ኣብዚ ተሌፎን እዚ ጥራይ ይዕቀቡ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya disimpan di ponsel ini, untuk surat Anda berikutnya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在本手机上，方便您以后写信使用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ इसी फ़ोन पर सेव रहती है, आपके अगले पत्रों के लिए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই ফোনেই সংরক্ষিত থাকে, আপনার পরবর্তী চিঠির জন্য।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொலைபேசியில் மட்டுமே சேமிக்கப்படும், உங்கள் அடுத்த கடிதங்களுக்காக."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ในโทรศัพท์เครื่องนี้เท่านั้น สำหรับจดหมายฉบับต่อไปของคุณ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся только на этом телефоне, для ваших следующих писем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігаються лише на цьому телефоні, для ваших наступних листів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefonda, sonraki mektuplarınız için saklanır."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas apenas neste celular, para as suas próximas cartas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan solo en este teléfono, para sus próximas cartas."
          }
        }
      }
    },
    "Glissez un dossier vers la gauche pour le supprimer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe an application to the left to delete it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الملف إلى اليسار لحذفه."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای حذف پرونده، آن را به سمت چپ بکشید."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د دوسیې د ړنګولو لپاره یې کیڼ لور ته کش کړئ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل حذف کرنے کے لیے اسے بائیں طرف سلائیڈ کریں۔"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይል ንምድምሳስ ናብ ጸጋም ስሓብዎ።"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser berkas ke kiri untuk menghapusnya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将档案向左滑动即可删除。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ाइल को हटाने के लिए उसे बाईं ओर खिसकाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ফাইল মুছতে সেটি বাঁ দিকে সরান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கோப்பை நீக்க அதை இடதுபுறம் தள்ளுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดแฟ้มไปทางซ้ายเพื่อลบ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по делу влево, чтобы удалить его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть по справі вліво, щоб видалити її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmek için bir dosyayı sola kaydırın."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um processo para a esquerda para excluí-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslice un trámite hacia la izquierda para eliminarlo."
          }
        }
      }
    },
