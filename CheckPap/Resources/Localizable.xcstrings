    "Toutes vos pièces sont prêtes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your documents are ready."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع وثائقك جاهزة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه مدارک شما آماده است."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "ستاسو ټول اسناد چمتو دي."
          }
